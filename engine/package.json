{
  "name": "@mi-mundo/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor audiovisual Remotion de Mi Mundo Engine (multi-marca).",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "render": "remotion render src/Root.tsx",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "render:test-kutt": "remotion render src/Root.tsx BrandRouter out/kutt/kutt-test.mp4 --props=public/test-brandrouter-kutt.json",
    "render:kutt-viral": "remotion render src/Root.tsx MotorJSON out/kutt/kutt-viral.mp4 --props=public/test-kutt-viral.json",
    "still:kutt-viral": "remotion still src/Root.tsx MotorJSON out/kutt/kutt-viral.png --props=public/test-kutt-viral.json",
    "render:test-3d": "remotion render src/Root.tsx BrandRouter out/nicolas-lopez/barrera-3d.mp4 --frames=0-59 --props=public/test-brandrouter-nicolas.json",
    "render:nicolas-hyperframes": "remotion render src/Root.tsx MotorJSON out/nicolas-lopez/hyperframes.mp4 --props=public/test-nicolas-hyperframes.json",
    "still:nicolas-hyperframes": "remotion still src/Root.tsx MotorJSON out/nicolas-lopez/hyperframes.png --props=public/test-nicolas-hyperframes.json",
    "gpu": "remotion gpu",
    "browser:ensure": "remotion browser ensure"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.544",
    "@remotion/player": "4.0.544",
    "@remotion/tailwind-v4": "4.0.544",
    "@remotion/three": "4.0.544",
    "@remotion/zod-types": "4.0.544",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.544",
    "three": "^0.187.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
