# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración LOCAL del motor (PC con GPU).
# setup-local.ps1 la copia a engine/.env (ignorado por git). Nunca subas .env.
# Nombre sin punto inicial a propósito: las reglas de seguridad del agente
# bloquean cualquier archivo .env*; esta plantilla no contiene secretos.
# ─────────────────────────────────────────────────────────────────────────────

# Renderizador OpenGL. En Windows con GPU: angle (Direct3D 11 vía ANGLE).
# NO uses "swangle" en local: es render por CPU (solo para la nube sin GPU).
# Alternativas si angle falla: vulkan, angle-egl.
REMOTION_GL=angle

# Vacío = Remotion usa su Chrome Headless Shell (lo descarga setup-local.ps1).
REMOTION_BROWSER_EXECUTABLE=

# Pestañas de render en paralelo: número ("6") o porcentaje de núcleos ("50%").
REMOTION_CONCURRENCY=50%

# ── Secretos futuros (solo en tu PC; NUNCA en el repo ni en la nube) ─────────
# ELEVENLABS_API_KEY=
